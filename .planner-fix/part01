+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { createDraftAutosaver } from './draftAutosave';
+import { saveLocalCourse } from './localCourses';
+
+describe('reliable local persistence', () => {
+  beforeEach(() => vi.useFakeTimers());
+  afterEach(() => { vi.useRealTimers(); vi.unstubAllGlobals(); });
+  it('debounces edits and flushes the latest value before the timer', () => {
+    const write = vi.fn(), report = vi.fn();
+    const saver = createDraftAutosaver(write, report);
+    saver.update('first'); saver.update('latest');
+    expect(write).not.toHaveBeenCalled();
+    saver.flush(); vi.runAllTimers();
+    expect(write.mock.calls).toEqual([['latest']]);
+    expect(report).toHaveBeenLastCalledWith({ snapshot: 'latest', ok: true });
+  });
+  it.each(['QuotaExceededError', 'SecurityError'])('retains draft and reports %s until a successful retry', (name) => {
+    const write = vi.fn().mockImplementationOnce(() => { throw new DOMException('denied', name); });
+    const report = vi.fn(), saver = createDraftAutosaver(write, report);
+    saver.update('precious draft'); vi.runAllTimers();
+    expect(report).toHaveBeenLastCalledWith({ snapshot: 'precious draft', ok: false });
+    saver.retry();
+    expect(write.mock.calls).toEqual([['precious draft'], ['precious draft']]);
+    expect(report).toHaveBeenLastCalledWith({ snapshot: 'precious draft', ok: true });
+  });
+  it('does not overwrite local draft by opening an unedited template, even on exit', () => {
+    const write = vi.fn(), saver = createDraftAutosaver(write, vi.fn());
+    saver.update('template', 'template'); vi.runAllTimers(); saver.dispose();
