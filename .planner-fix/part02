+import { describe, expect, it } from 'vitest';
+import { parseCourseJson } from './importJson';
+import { buildDogPath, sampleDogPathAt } from './dogPath';
+import { getObstacleDefV2 } from './config';
+
+const rawFciCourse = {
+  version: 2, name: 'Roundtrip FCI H2', sport: 'hoopers', sizeClass: 'L',
+  arenaWidthM: 20, arenaHeightM: 40, classTemplate: 'hoopers_fci_h2',
+  ruleSetId: 'hoopers-fci-2026',
+  obstacles: [{ id: 'hoop-1', type: 'hoop', x: 10, y: 10, rotation: 0, number: 1 }],
+};
+
+describe('independent planner reliability regressions', () => {
+  it('keeps BOTH the non-default rule set AND its own class through two imports', () => {
+    const first = parseCourseJson(JSON.stringify(rawFciCourse));
+    expect(first.ok).toBe(true);
+    if (!first.ok) return;
+    expect(first.course.ruleSetId).toBe('hoopers-fci-2026');
+    expect(first.course.classTemplate).toBe('hoopers_fci_h2');
+    const second = parseCourseJson(JSON.stringify({version: 2, ...first.course}));
+    expect(second.ok).toBe(true);
+    if (second.ok) expect(second.course).toEqual(first.course);
+  });
+
+  for (const curveDeg of [0, 15, 90, 180]) {
+    for (const curveSide of ['left', 'right'] as const) {
+      it(`samples the actual tunnel length, ${curveDeg} degrees ${curveSide}`, () => {
+        const obstacle = {id: 't', type: 'tunnel' as const, x: 10, y: 10,
+          rotation: 0, number: 1, curveDeg, curveSide};
+        const path = buildDogPath([obstacle]);
+        const geometricLength = path.points.slice(1).reduce((total, p, i) =>
+          total + Math.hypot(p.x-path.points[i].x, p.y-path.points[i].y), 0);
+        expect(path.total).toBeCloseTo(geometricLength, 8);
+        expect(path.cum[path.cum.length-1]).toBeCloseTo(path.total, 8);
+        const midpoint = sampleDogPathAt(path, 0.5)!;
+        const width = getObstacleDefV2('tunnel')!.sizeM.w;
+        const theta = curveDeg * Math.PI / 180;
+        const radius = theta > 0 ? width/(2*Math.sin(theta/2)) : 0;
+        const expectedOffset = theta > 0 ? radius*(1-Math.cos(theta/2)) : 0;
+        expect(Math.abs(midpoint.x-10)).toBeLessThan(0.02);
