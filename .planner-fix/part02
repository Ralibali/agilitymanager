index 0000000..1c0f293
--- /dev/null
+++ b/src/features/course-planner-v2/draftAutosave.ts
@@ -0,0 +1,30 @@
+/** Pure save scheduler. Failed writes retain the current in-memory payload for
+ * retry. Opening an external copy does not adopt it until its first edit;
+ * after adoption an undo back to the original must still be persisted. */
+export type DraftSaveResult = { snapshot: string; ok: boolean };
+export function createDraftAutosaver(write: (value: string) => void, report: (result: DraftSaveResult) => void, delay = 600) {
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  let pending: string | null = null;
+  let source: string | null = null;
+  let adopted = false;
+  const flush = () => {
+    clearTimeout(timer);
+    if (pending === null) return;
+    const value = pending;
+    try { write(value); pending = null; report({ snapshot: value, ok: true }); }
+    catch { report({ snapshot: value, ok: false }); }
+  };
+  return {
+    update(value: string, protectedSnapshot: string | null = null, blocked = false) {
+      clearTimeout(timer);
+      if (source !== protectedSnapshot) { source = protectedSnapshot; adopted = false; }
+      if (blocked || (!adopted && source !== null && value === source)) { pending = null; return; }
+      adopted = true;
+      pending = value;
+      timer = setTimeout(flush, delay);
+    },
+    flush,
+    retry: flush,
+    dispose: flush,
+  };
+}
