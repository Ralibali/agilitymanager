+/** Shared tunnel centreline in metres. Width remains the mouth-to-mouth chord
+ * used by existing saved courses; bending never silently changes that measure.
+ * A sampled circular arc (<= 2 degree steps) is used by 2D, PDF, 3D and playback.
+ * This is planning geometry, not a prediction of an individual dog's movement. */
+export interface TunnelPoint { x: number; y: number }
+export function tunnelGeometry(width: number, degrees = 0, side: "left" | "right" = "right", rotation = 0, x = 0, y = 0) {
+  const w = Number.isFinite(width) ? Math.max(0.001, width) : 3;
+  const angle = (Number.isFinite(degrees) ? Math.max(0, Math.min(180, degrees)) : 0) * Math.PI / 180;
+  const sign = side === "left" ? -1 : 1;
+  const half = angle / 2;
+  const radius = angle > 1e-6 ? w / (2 * Math.sin(half)) : 0;
+  const segments = radius ? Math.max(2, Math.ceil(degrees / 2)) : 1;
+  const r = rotation * Math.PI / 180, c = Math.cos(r), s = Math.sin(r);
+  const vector = (a: number, b: number): TunnelPoint => ({ x: a * c - b * s, y: a * s + b * c });
+  const points = Array.from({ length: segments + 1 }, (_, i) => {
+    const t = i / segments, a = -half + angle * t;
+    const p = vector(radius ? radius * Math.sin(a) : w * (t - 0.5),
+      radius ? sign * radius * (Math.cos(a) - Math.cos(half)) : 0);
+    return { x: x + p.x, y: y + p.y };
+  });
+  // Pin exact mouths so rotations and reversing the samples do not drift.
+  const entry = vector(-w / 2, 0), exit = vector(w / 2, 0);
+  points[0] = { x: x + entry.x, y: y + entry.y };
+  points[segments] = { x: x + exit.x, y: y + exit.y };
+  let length = 0;
+  for (let i = 1; i < points.length; i++) length += Math.hypot(points[i].x - points[i-1].x, points[i].y - points[i-1].y);
+  return { points, length, entry: points[0], exit: points[segments],
+    entryDir: vector(Math.cos(half), sign * Math.sin(half)),
+    exitDir: vector(Math.cos(half), -sign * Math.sin(half)),
+    samplingErrorM: radius ? radius * (1 - Math.cos(angle / (2 * segments))) : 0,
+  };
+}
+export function tunnelBounds(width: number, depth: number, degrees: number, side: "left" | "right", rotation: number, x: number, y: number) {
+  const g = tunnelGeometry(width, degrees, side, rotation, x, y);
+  const padding = depth / 2 + g.samplingErrorM;
+  return { minX: Math.min(...g.points.map(p => p.x)) - padding,
+    maxX: Math.max(...g.points.map(p => p.x)) + padding,
+    minY: Math.min(...g.points.map(p => p.y)) - padding,
+    maxY: Math.max(...g.points.map(p => p.y)) + padding };
+}
