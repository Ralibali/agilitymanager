+    const t = { id:'t', type:'tunnel' as const, x:10, y:10, rotation:0, number:2, curveDeg:90, curveSide:'right' as const };
+    const normal = tunnelGeometry(3, 90, 'right', 0, 10, 10);
+    const previous = { id:'p', type:'jump' as const, x:20, y:10, rotation:90, number:1 };
+    const path = buildDogPath([previous, t]);
