+    expect(validateCourse(course).some(i => i.obstacleId === 't' && i.code === 'obstacle_outside_arena')).toBe(true);
+  });
+  it('preserves empty internal drafts but still rejects empty external imports', () => {
+    const raw = {...rawFciCourse, name:'My empty arena', arenaWidthM:45, obstacles:[]};
+    const parsed = parseCourseJson(JSON.stringify(raw), {allowEmpty:true});
+    expect(parsed.ok).toBe(true);
+    if(parsed.ok) { expect(parsed.course.arenaWidthM).toBe(45); expect(parsed.course.classTemplate).toBe('hoopers_fci_h2'); }
+    expect(parseCourseJson(JSON.stringify(raw)).ok).toBe(false);
+  });
+  it('falls back with a warning instead of mixing rules from another sport', () => {
+    const parsed = parseCourseJson(JSON.stringify({...rawFciCourse, sport:'agility'}));
+    expect(parsed.ok).toBe(true);
+    if(parsed.ok) { expect(parsed.course.ruleSetId).toBe('skk-agility-2023'); expect(parsed.course.classTemplate).toBeNull(); expect(parsed.warnings.length).toBeGreaterThan(0); }
+  });
+  it('retains the non-default fixed time after import (no silent default rules)', () => {
+    const parsed = parseCourseJson(JSON.stringify(rawFciCourse));
+    expect(parsed.ok).toBe(true);
+    if(parsed.ok) expect(computeCourseTimes(parsed.course).maxTimeS).toBe(180);
+  });
+});
