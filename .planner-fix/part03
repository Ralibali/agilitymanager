+describe('geometry, bounds and ruleset invariants', () => {
+  it('rotates the tunnel around its placement without changing length', () => {
+    const base = tunnelGeometry(3, 90, 'right');
+    const rotated = tunnelGeometry(3, 90, 'right', 90, 10, 20);
